---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import '../styles/stage.css';
import { books, bookFor, bookHref, chapterHref as hrefForChapter, relatedFor } from '../books';
import { site } from '../site';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

// MDX passes frontmatter both spread and as `frontmatter`; accept either.
const fm = (Astro.props as any).frontmatter ?? Astro.props;
const slug: string | undefined = fm.slug;
const currentBook = bookFor(fm.book);
const { chapters: bookChapters, name: bookName, tagline: bookTagline, taglineZh: bookTaglineZh } = currentBook;
const chapterHref = (s: string) => hrefForChapter(currentBook, s);
const idx = bookChapters.findIndex((c) => c.slug === slug);
const chapter = idx >= 0 ? bookChapters[idx] : undefined;
const related = chapter ? relatedFor(currentBook.id, chapter.slug) : [];
const sidebarBooks = chapter ? [currentBook] : books;
const title: string = fm.title ?? chapter?.title ?? bookName;
const titleZh: string = chapter?.titleZh ?? title;
const hook: string | undefined = fm.hook ?? chapter?.hook;
const hookZh: string | undefined = chapter?.hookZh;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pad = (n: number) => String(n).padStart(2, '0');
const prev = idx > 0 ? bookChapters[idx - 1] : undefined;
const next = idx >= 0 ? bookChapters[idx + 1] : undefined;
// what a shared link shows: the home page is the site alone, a chapter its title and hook; one card image for all (npm run og)
const pageTitle = chapter ? `${title} · ${bookName}` : bookName;
const pageTitleZh = chapter ? `${titleZh} · ${bookName}` : bookName;
const description = chapter ? `Chapter ${idx + 1} of ${bookName}. ${hook ?? ''}`.trim() : `${site.tagline} An illustrated guide, one picture per chapter.`;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const image = new URL(`${base}/og.png`, Astro.site);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <!-- preloaded so a page's first paint already has them: a font swapping in after it shifts the sidebar's text -->
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-title-en={pageTitle} data-title-zh={pageTitleZh}>
    <script is:inline>
      // Language choice, applied before first paint. Static text switches via html[data-lang] (see global.css);
      // the Svelte components pick it up from the same attribute after hydration (src/i18n.ts).
      (() => {
        const apply = (l) => {
          document.documentElement.dataset.lang = l;
          document.documentElement.lang = l === 'zh' ? 'zh-CN' : 'en';
          document.title = document.body.dataset[l === 'zh' ? 'titleZh' : 'titleEn'];
        };
        apply(localStorage.getItem('lang') === 'zh' ? 'zh' : 'en');
        window.__toggleLang = () => {
          const l = document.documentElement.dataset.lang === 'zh' ? 'en' : 'zh';
          localStorage.setItem('lang', l);
          apply(l);
          window.dispatchEvent(new CustomEvent('langchange', { detail: l }));
        };
      })();
    </script>
    <div class="shell">
      <nav class="sidebar" data-book={chapter ? currentBook.id : 'home'}>
        <div class="brandrow">
          <a class="brand" href={`${base}/`}>{bookName}</a>
          <button class="lang-toggle" onclick="window.__toggleLang()" aria-label="Switch language / 切换语言">
            <span class="i18n-en">中文</span><span class="i18n-zh">English</span>
          </button>
          <button class="menu" type="button" aria-expanded="false" aria-controls="navbody"><span class="i18n-en">Chapters</span><span class="i18n-zh">章节</span></button>
        </div>
        <div class="navbody" id="navbody">
        <p class="tagline"><span class="i18n-en">{bookTagline}</span><span class="i18n-zh">{bookTaglineZh}</span></p>
        <div class="book-switcher">
          <div class="part-title"><span class="i18n-en">Four books</span><span class="i18n-zh">四本书</span></div>
          {books.map((book) => (
            <a class:list={[{ current: chapter && book.id === currentBook.id }]} href={bookHref(book)}>
              <span>{book.navName}</span><span class="book-count">{book.chapters.filter((c) => c.ready).length}/{book.chapters.length}</span>
            </a>
          ))}
        </div>
        {sidebarBooks.map((sidebarBook) => (
          <div class="book-group">
            {!chapter && <a class="book-nav-title" href={bookHref(sidebarBook)}>{sidebarBook.name}<span>{sidebarBook.chapters.filter((c) => c.ready).length}/{sidebarBook.chapters.length}</span></a>}
            {sidebarBook.parts.map((p) => (
              <div class="part">
                <div class="part-title"><span class="i18n-en">{p.title}</span><span class="i18n-zh">{p.titleZh}</span></div>
                <ol>
                  {sidebarBook.chapters.map((c, i) => c.part === p.id && (
                    <li class:list={[{ current: c.slug === slug, soon: !c.ready }]}>
                      {c.ready
                        ? <a href={hrefForChapter(sidebarBook, c.slug)}><span class="n">{pad(i + 1)}</span><span class="i18n-en">{c.title}</span><span class="i18n-zh">{c.titleZh}</span></a>
                        : <span><span class="n">{pad(i + 1)}</span><span class="i18n-en">{c.title}</span><span class="i18n-zh">{c.titleZh}</span></span>}
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        ))}
        {related.length > 0 && (
          <div class="related-links">
            <div class="part-title"><span class="i18n-en">Across the books</span><span class="i18n-zh">跨书相关章节</span></div>
            {related.map((r) => (
              <a href={r.href}>
                <span class="related-label"><span class="i18n-en">{r.label}</span><span class="i18n-zh">{r.labelZh}</span></span>
                <span class="related-target">{r.book.navName} · <span class="i18n-en">Ch. {r.number}</span><span class="i18n-zh">第 {r.number} 章</span></span>
                <span class="related-title"><span class="i18n-en">{r.chapter.title}</span><span class="i18n-zh">{r.chapter.titleZh}</span></span>
              </a>
            ))}
          </div>
        )}
        <div class="hints"><kbd>←</kbd> <kbd>→</kbd> <span class="i18n-en">step</span><span class="i18n-zh">切换步骤</span></div>
        <p class="byline"><span class="i18n-en">Original <a href={site.originalAuthor.url}>{site.originalAuthor.name}</a> · expanded by <a href={site.expandedBy.owner.url}>{site.expandedBy.owner.name}</a> &amp; {site.expandedBy.agent.name}</span><span class="i18n-zh">原教程 <a href={site.originalAuthor.url}>{site.originalAuthor.name}</a> · 扩展 <a href={site.expandedBy.owner.url}>{site.expandedBy.owner.name}</a> 与 {site.expandedBy.agent.name}</span></p>
        <a class="repo" href={site.repo} target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          <span class="i18n-en">Star on GitHub</span><span class="i18n-zh">在 GitHub 点星</span>
        </a>
        </div>
      </nav>
      <script is:inline>
        (() => {
          const nav = document.querySelector('.sidebar');
          const menu = nav.querySelector('.menu');
          menu.addEventListener('click', () => menu.setAttribute('aria-expanded', String(nav.classList.toggle('open'))));
          // Keep each book's sidebar where the reader left it. Runs before first paint, so it never jumps.
          // Only where the sidebar is its own scroll box: on a phone it is not, and scrollIntoView would scroll the page.
          if (!matchMedia('(min-width: 901px)').matches) return;
          const scrollKey = `sidebar-scroll-${nav.dataset.book}`;
          let saved = null;
          try { saved = sessionStorage.getItem(scrollKey); } catch {}
          if (saved !== null) nav.scrollTop = +saved;
          else nav.querySelector('li.current')?.scrollIntoView({ block: 'center' });
          addEventListener('pagehide', () => { try { sessionStorage.setItem(scrollKey, String(nav.scrollTop)); } catch {} });
        })();
      </script>
      {chapter ? (
        <main class="stage">
          <header class="stage-head">
            <div>
              <div class="kicker"><span class="i18n-en">Chapter {pad(idx + 1)}</span><span class="i18n-zh">第 {idx + 1} 章</span></div>
              <div class="titles">
                <h1><span class="i18n-en">{title}</span><span class="i18n-zh">{titleZh}</span></h1>
                {hook && <p class="hook"><span class="i18n-en">{hook}</span><span class="i18n-zh">{hookZh}</span></p>}
              </div>
            </div>
            <nav class="chapter-nav" aria-label="chapters">
              {prev && (prev.ready ? <a href={chapterHref(prev.slug)}>← <span class="i18n-en">{prev.title}</span><span class="i18n-zh">{prev.titleZh}</span></a> : <span>← <span class="i18n-en">{prev.title}</span><span class="i18n-zh">{prev.titleZh}</span></span>)}
              {next && (next.ready ? <a href={chapterHref(next.slug)}><span class="i18n-en">{next.title}</span><span class="i18n-zh">{next.titleZh}</span> →</a> : <span><span class="i18n-en">{next.title}</span><span class="i18n-zh">{next.titleZh}</span> <em><span class="i18n-en">soon</span><span class="i18n-zh">即将上线</span></em> →</span>)}
            </nav>
          </header>
          <slot />
        </main>
      ) : (
        <main class="home"><slot /></main>
      )}
    </div>
  </body>
</html>
